PORT=8080
HOST=0.0.0.0
# Private ingestion jobs (/jobs/*). Leave false on the public service.
JOBS_ENABLED=false
# firestore (Cloud Run, Application Default Credentials) or memory (local smoke runs only)
JOBS_STORE=firestore
# Optional overrides; ADC normally supplies the project.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=
# Warning push (jobs service only): send pending JMA handoffs to an FCM topic from
# /jobs/outbox/deliver. Strictly true or false; off by default. Uses Application Default
# Credentials (runtime SA needs roles/firebasecloudmessaging.admin). See docs/push-notifications.md.
FCM_DELIVERY_ENABLED=false
# Topic the Android app subscribes to; must match WARNING_TOPIC in android/app/build.gradle.kts.
FCM_TOPIC=contour-aichi-warnings
# Public /api/sites and /api/alerts read the job outputs: firestore, memory (empty) or off.
LIVE_DATA_STORE=firestore
# Gemini assistant at POST /api/assistant (Vertex AI with ADC; runtime SA needs roles/aiplatform.user).
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_LOCATION=global
# Assistant requests per client IP and in total, per minute, per instance.
ASSISTANT_PER_CLIENT_PER_MINUTE=8
ASSISTANT_TOTAL_PER_MINUTE=60

# Public browser key, restricted to Firebase Hosting referrers + Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
