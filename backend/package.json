  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google/genai": "^1.52.0",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "firebase-admin": "^14.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
