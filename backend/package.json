{
  "name": "@contour/backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx scripts/sync-indoor.mjs && tsx watch src/server.ts",
    "build": "tsx scripts/sync-indoor.mjs && tsc && node scripts/copy-data.mjs",
    "start": "node dist/src/server.js",
