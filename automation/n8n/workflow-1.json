      "id": "2784d643-bd5f-4f93-b3a1-c51df22bd4d0",
      "name": "Download official Nagoya CSV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [576, 224],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "options": {
          "encoding": "utf-8",
          "enableBOM": true,
          "headerRow": true,
          "includeEmptyCells": true,
          "maxRowCount": -1,
          "skipRecordsWithErrors": {
            "value": {}
          }
        }
      },
      "id": "bcec9617-efa3-4c7f-848b-17d6abe1e91c",
      "name": "Extract CSV records",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [864, 224],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Import configuration').first().json;\nconst rows = $input.all().map(item => item.json).filter(row => Object.keys(row).length > 0);\nconst errors = [];\nconst sites = [];\nconst ids = new Set();\nconst hazards = {\n '洪水':'flood','崖崩れ、土石流及び地滑り':'landslide','高潮':'stormSurge',\n '地震':'earthquake','津波':'tsunami','大規模な火事':'fire','内水氾濫':'inlandFlood','火山現象':'volcano'\n};\nconst required = ['共通ID','施設・場所名','住所','緯度','経度',...Object.keys(hazards)];\nif (rows.length === 0 || rows.length > 10000) errors.push('Unexpected record count; expected 1–10000.');\nfor (let index=0;index<rows.length;index++) {\n const row = rows[index];\n for(const key of required) if (!(key in row)) errors.push('Row '+(index+1)+': missing column '+key);\n const id = String(row['共通ID'] ?? '').trim();\n const name = String(row['施設・場所名'] ?? '').trim();\n const latitudeText = String(row['緯度'] ?? '').trim();\n const longitudeText = String(row['経度'] ?? '').trim();\n const latitude = Number(latitudeText), longitude = Number(longitudeText);\n if (!id || ids.has(id)) errors.push('Row '+(index+1)+': missing or duplicate common ID.');\n ids.add(id);\n if (!name) errors.push('Row '+(index+1)+': missing name.');\n if (!latitudeText || !longitudeText || !Number.isFinite(latitude) || !Number.isFinite(longitude) || latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180)\n  errors.push('Row '+(index+1)+': invalid coordinates.');\n const disasters = [];\n for(const [column,code] of Object.entries(hazards)){\n  const flag=String(row[column] ?? '').trim();\n  if(flag==='1') disasters.push(code);\n  else if(flag!=='') errors.push('Row '+(index+1)+': unknown hazard flag in '+column);\n }\n if(!disasters.length) errors.push('Row '+(index+1)+': no designated hazard.');\n sites.push({\n  id,name,address:String(row['住所']??'').trim(),latitude,longitude,disasters,\n  kind:'emergencySite',source:'GSI / Nagoya City designated emergency evacuation sites',\n  verifiedAt:null,isDemo:false,openingStatus:'unknown',remarks:String(row['備考']??'').trim()\n });\n}\nsites.sort((a,b)=>a.id.localeCompare(b.id));\nconst valid=errors.length===0;\nreturn [{json:{\n valid,errors:errors.slice(0,20),errorCount:errors.length,\n municipalityCode:cfg.municipalityCode,municipalityName:cfg.municipalityName,\n sourceUrl:cfg.sourceUrl,sourceAttribution:cfg.sourceAttribution,\n lastCheckedAt:cfg.startedAt,recordCount:rows.length,\n payloadJson:valid?JSON.stringify(sites):'',datasetVersion:'nagoya-'+$execution.id,\n currentKey:'current:'+cfg.municipalityCode,snapshotKey:'snapshot:'+cfg.municipalityCode+':'+$execution.id,\n entryType:'designation_only',backendConnected:false\n}}];"
      },
