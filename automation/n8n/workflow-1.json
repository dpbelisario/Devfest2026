    {
      "parameters": {
        "jsCode": "const candidate = $('Validate complete dataset').first().json;\nconst currentRows = $input.all();\nif(currentRows.length!==1 || currentRows[0].json.recordKey!==candidate.currentKey)\n throw new Error('Expected exactly one current dataset state row; preserve previous data.');\nconst current = currentRows[0].json;\nif(Number(current.recordCount)>0 && candidate.recordCount < Number(current.recordCount)*0.5)\n throw new Error('Dataset shrank by more than 50%; review source before publishing.');\nconst changed = candidate.payloadJson !== String(current.payloadJson ?? '');\nreturn [{json:{...candidate,changed,\n datasetVersion:changed?candidate.datasetVersion:current.datasetVersion,\n lastChangedAt:changed?candidate.lastCheckedAt:current.lastChangedAt,\n status:changed?'published_to_n8n':'unchanged'\n}}];"
      },
