# Copy to local.properties; never commit the real file.
# Android Studio normally writes sdk.dir automatically.
# sdk.dir=/absolute/path/to/Android/sdk
EVACUATION_AR_API_BASE_URL=http://10.0.2.2:8080/
# Use your HTTPS Cloud Run URL on a physical phone.
# Configure restricted Android ARCore credentials when implementing AR.
# Optional: load the Contour UI from the backend (https only) instead of the bundled copy.
# CONTOUR_UI_URL=https://<your-backend>/app/

# IndoorAtlas mobile SDK credentials (APK credentials, not server/admin keys).
# Also accepted as build environment variables; never place them in HTML.
# INDOORATLAS_API_KEY=
# INDOORATLAS_API_SECRET=
# Optional fallback venue/POI, used only when neither the backend venue list
# (GET api/indoor/venues, docs/indoor-venues.md) nor the on-device cache is available.
# INDOORATLAS_VENUE_ID=
# Without a POI ID the SDK requires one unique POI named 221 / Room 221.
# INDOORATLAS_ROOM221_POI_ID=
